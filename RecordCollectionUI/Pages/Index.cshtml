@page
@*@model IndexModel*@
@{
    ViewData["Title"] = "Record Collection";
}
<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            background-color: #44344F;
        }
    </style>
</head>
<body>
    <div class="indexHeader">
        Welcome to the Record Collection!
    </div>
    <div class="mx-auto p-2" style="width:315px;">
