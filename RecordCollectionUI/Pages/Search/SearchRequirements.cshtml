@page
@model RecordCollectionUI.Pages.Search.SearchRequirementsModel
@{
    ViewData["Title"] = "Search";
}
<form method="post">
    <div class="text-center" style="margin: 10px">
        Search for...
    </div>
    <div class="container">
        <div class="row mb-3" text-center><!--Artists Dropdown-->
            <label for="ddlArtist" class="col-sm-3 col-form-label text-end">Artist:</label>
            <div class="col-sm-6 text-start">
                <select asp-for="NewAlbum.ArtistID" asp-items="@Model.Artists" id="ddlArtist"></select>
            </div>
        </div>
        <div class="row mb-3 text-center"><!--Search for Album by name-->
            <label for="searchAlbumName" class="col-sm-3 col-form-label text-end">Album Name:</label>
            <div class="col-sm-6 text-center">
                <input type="text" id="searchAlbumName" class="form-control" />
            </div>
        </div>
        <div class="row mb-3 text-center"><!--Search for Albums by year-->
            <label for="searchYear" class="col-sm-3 col-form-label text-end">Year:</label>
            <div class="col-sm-6 text-center">
                <input type="text" id="searchYear" class="form-control" />
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-3 col-form-label text-end">Genre: </label>
            <div class="col-sm-9">
                @for (var i = 0; i < Model.GenreList.Count(); i++)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="GenresSelected" checked="@Model.GenreList[i].Selected" id="@Model.GenreList[i].Text" value="@Model.GenreList[i].Value" />
                        <label class="form-check-label" for="@Model.GenreList[i].Text">@Model.GenreList[i].Text</label>
                    </div>
                }
            </div>
 
        </div>
        <<div class="text-center">
            <a class="btn btn-secondary" asp-page="Results">Search</a>
        </div>
        
    </div>

</form>