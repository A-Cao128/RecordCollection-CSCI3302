@page
@model RecordCollectionUI.Pages.Albums.AddAlbumModel
@{
}
<form method="post">
    <div class="row mb-3">
        <label for="inputAlbumTitle" class="col-sm-2 col-form-label">Album Title:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="inputAlbumTitle" />
        </div>
    </div>

    <div class="row mb-3">
        <label for="inputNumberOfTracks" class="col-sm-2 col-form-label">Number of Tracks:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="inputNumberOfTracks" />
        </div>
    </div>

    <div class="row mb-3">
        <label for="inputReleaseDate" class="col-sm-2 col-form-label">Release Date:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="inputReleaseDate" />
        </div>
    </div>

    <div class="row mb-3">
        <label for="inputPrice" class="col-sm-2 col-form-label">Price:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="inputPrice" />
        </div>
    </div>

    <div class="row mb-3">
        <label for="inputAlbumCoverImageURL" class="col-sm-2 col-form-label">Album Cover:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="inputAlbumCoverImageURL" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Add Album</button>
</form>