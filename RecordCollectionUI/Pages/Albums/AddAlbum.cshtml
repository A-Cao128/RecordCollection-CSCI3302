@page
@model RecordCollectionUI.Pages.Albums.AddAlbumModel
@{
}
<form method="post">
    <div class="row mb-3">
        <label for="inputAlbumName" class="col-sm-2 col-form-label">Album Name:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="inputAlbumName" />
        </div>
    </div>

    <div class="row mb-3">
        <label for="inputAlbumBio" class="col-sm-2 col-form-label">Album Bio:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="inputAlbumBio" />
        </div>
    </div>

    <div class="row mb-3">
        <label for="inputAlbumImage" class="col-sm-2 col-form-label">Album Image:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="inputAlbumName" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Add Album</button>
</form>