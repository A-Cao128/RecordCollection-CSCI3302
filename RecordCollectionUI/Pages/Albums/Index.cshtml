@page
@model RecordCollectionUI.Pages.Albums.IndexModel
@{
}
<!--bootstrap row has 12 columns-->
<div class="container">
    <div class="row mb-3">
        <!--mb is margin-bottom, number is number of pixels-->
        <div class="col-sm-3">
            <h2>Album List</h2>
        </div>
        <div class="col-sm-9">
            <a class="btn btn-primary" asp-page="AddAlbum">Add Album</a>
        </div>
    </div>
    @foreach (var album in Model.AlbumList)
    {
        <!--Album List-->
        <div class="row mb-3">
            <div class="col-sm-3">
                <!--Where Album image goes-->
                <img class="album-image" src="@album.AlbumCoverImageURL" />
            </div>
            <div class="col-sm-8">
                <!--Where Album information goes-->
                <div class="row">
                    <!--Album tile here-->
                    <div style="font-weight:bold; color:#AFD5AA; font-size:x-large" class="col-sm-12">
                        @album.AlbumTitle
                    </div>
                </div>
                <div class="row">
                    <!--No. of track here-->
                    <div style="color:#AFD5AA; font-family:monospace" class="col-sm-12">
                        Number of tracks: @album.NumberOfTracks
                    </div>
                </div>
                <div class="row">
                    <!--Album relase date here-->
                    <div style="color:#AFD5AA; font-family:monospace" class="col-sm-12">
                        Release Year: @album.ReleaseYear
                    </div>
                </div>
                <div class="row">
                    <!--Album price here-->
                    <div style="color:#AFD5AA; font-family:monospace" class="col-sm-12">
                        @album.Price
                    </div>
                </div>
            </div>
            <div class="col-sm-1">
                <div class="col-sm-12">
                    <a asp-page="EditAlbum" asp-route-id="@album.AlbumID" style="color:#98A6D4">
                        <i class="bi bi-pencil-square mx-2" style="font-size: 45px"></i>
                    </a>
                    <a asp-page="DeleteAlbum" asp-route-id="@album.AlbumID" style="color:#98A6D4">
                        <i class="bi bi-trash3" style="font-size: 45px"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
