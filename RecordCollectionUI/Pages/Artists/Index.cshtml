@page
@model RecordCollectionUI.Pages.Artists.IndexModel
@{
    ViewData["Title"] = "Artists";
}
<form method = "get">
    <div class="input-group">
        <input class="form-control" asp-for="SearchTerm"/>
        <div>
            <button type="submit" class="btn btn-secondary">Search</button>
        </div>
    </div>
</form>


<!--bootstrap row has 12 columns-->
<div class="container">
    <div class="row mb-3">
        <!--mb is margin-bottom, number is number of pixels-->
        <div class="col-sm-3">
            <h2 style="color:#AFD5AA">Artist List</h2>
        </div>
        <div class="col-sm-9">
            <a class="btn btn-secondary" asp-page="AddArtist">Add Artist</a>
        </div>
    </div>
    @foreach (var artist in Model.ArtistList)
    {
        <!--Artist List-->
        <div class="row mb-3">
            <div class="col-sm-3">
                <!--Where artist image goes-->
                <a href="@artist.ArtistWebsite"><img class = "artist-image" src="@artist.ArtistImageURL"/></a>
            </div>
            <div class="col-sm-8">
                <!--Where artist information goes-->
                <div class="row">
                    <!--Artist name here-->
                    <div style="font-weight:bold; color:#AFD5AA; font-size:x-large" class="col-sm-12">
                        @artist.ArtistName
                    </div>
                </div>
                <div class="row">
                    <!--Artist bio here-->
                    <div style="color:#AFD5AA; font-family:monospace" class="col-sm-12">
                        @artist.ArtistBio
                    </div>
                </div>
                <div class="row">
                    <!--Artist website here-->
                    <div class="col-sm-12">
                        <a href="@artist.ArtistWebsite" style="color:#98A6D4">@artist.ArtistName Website</a>
                    </div>
                </div>
            </div>
            <div class="col-sm-1">
                <div class="col-sm-12">
                    <a asp-page="EditArtist" asp-route-id="@artist.ArtistID" style="color:#98A6D4">
                        <i class="bi bi-pencil-square mx-2" style="font-size: 45px"></i>
                    </a>
                    <a asp-page="DeleteArtist" asp-route-id="@artist.ArtistID" style="color:#98A6D4"
                    onclick="return confirm('Are you sure you want to delete the author? The action cannot be undone')">
                        <i class="bi bi-trash3" style="font-size: 45px"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
