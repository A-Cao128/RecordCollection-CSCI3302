@page
@model RecordCollectionUI.Pages.Genres.IndexModel
@{
}
<style>
    h4{
        color: #AFD5AA;
        font-family: fantasy;


    }
    h2{
        color: #AFD5AA;
        font-family: fantasy;

    }
</style>
<div class="container">
    <div class="row mb-3">
        <div class="col-sm-3">
            <h2>Genre List</h2>
        </div>
        <div class="col-sm-9">
            <a asp-page="AddGenre" class="btn btn-secondary">Add Genre</a>
        </div>
    </div>
    <div class="row mb-3">
        <h4 class="col-sm-3">Genre ID</h4>
        <h4 class="col-sm-9">Genre Name</h4>
        @foreach (var obj in Model.Genres)
        {
            <div class="col-sm-3">
                <label class="genre form-text" style="color: #AFD5AA">@obj.GenreID</label>
            </div>
            <div class="col-sm-9">
                <label class="genre form-text" style="color: #AFD5AA">@obj.GenreName </label>
                <a asp-page="DeleteGenre" asp-route-id="@obj.GenreID" style="color:#98A6D4">
                            <i class="bi bi-trash mx-2">  </i>
                        </a>
            </div>
        }
    </div>
</div>

